# SkyPredict backend configuration — copy to `backend/.env` and adjust as needed.
# All variables are optional; unset values fall back to the defaults shown.
# Loaded from backend/.env regardless of the launch directory.
# Every variable is prefixed with SKYPREDICT_.

# --- Application metadata ---------------------------------------------------
# SKYPREDICT_APP_NAME="SkyPredict - Engine Health & RUL API"
# SKYPREDICT_APP_VERSION="1.0.0"

# --- Model artifacts --------------------------------------------------------
# Directory + filenames the backend loads at startup (relative to repo root).
# SKYPREDICT_MODELS_DIR="models"
# SKYPREDICT_MODEL_FILENAME="model.pkl"
# SKYPREDICT_METADATA_FILENAME="model_metadata.json"

# --- CORS (Streamlit dashboard origins) -------------------------------------
# JSON array format is required for list values.
# SKYPREDICT_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
